# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jaktrip
DB_USER=root
DB_PASSWORD=

# Database SSL (optional)
# Set to true/1/yes/on to enable SSL
DB_SSL=false
# Path to CA certificate file (optional, used when DB_SSL is enabled)
DB_SSL_CA=

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# CORS (optional, comma-separated; defaults to localhost:5173)
CORS_ORIGINS=

# Server (optional, used when running `python -m app.main`)
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=1
