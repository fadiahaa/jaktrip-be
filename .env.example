# Database Connection (PostgreSQL - Neon / Supabase / Aiven / Local)
# Option A: Full Connection URI (e.g. for Neon / Supabase pooled URI)
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Option B: Individual parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jaktrip_planner
DB_USER=postgres
DB_PASSWORD=password

# Database SSL (optional; automatically enabled for Neon/Supabase)
DB_SSL=false
DB_SSL_CA=

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# CORS (optional, comma-separated; defaults to localhost:5173)
CORS_ORIGINS=

# Server (optional, used when running `python -m app.main`)
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=1
